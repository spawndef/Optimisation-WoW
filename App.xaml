<Application x:Class="OptimisationWoW.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OptimisationWoW"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- Palette « World of Warcraft » : pierre sombre, parchemin et or.
         Les couleurs de faction (Brand, Brand2, BrandSoft, Glow, Grad) sont changées au démarrage par Theme.Apply (Horde ou Alliance). -->
    <SolidColorBrush x:Key="Bg" Color="#0C0907"/>
    <SolidColorBrush x:Key="Bg2" Color="#130E0A"/>
    <SolidColorBrush x:Key="Panel" Color="#1A140E"/>
    <SolidColorBrush x:Key="Panel2" Color="#241B12"/>
    <SolidColorBrush x:Key="Line" Color="#26D4AF37"/>
    <SolidColorBrush x:Key="Line2" Color="#40D4AF37"/>
    <SolidColorBrush x:Key="Ink" Color="#F5E9CF"/>
    <SolidColorBrush x:Key="Ink2" Color="#C9B48C"/>
    <SolidColorBrush x:Key="Ink3" Color="#8C7957"/>
    <SolidColorBrush x:Key="Brand" Color="#B3121B"/>
    <SolidColorBrush x:Key="Brand2" Color="#F06A5A"/>
    <SolidColorBrush x:Key="BrandSoft" Color="#26B3121B"/>
    <SolidColorBrush x:Key="Glow" Color="#40B3121B"/>
    <SolidColorBrush x:Key="Cyan" Color="#3FC7EB"/>
    <SolidColorBrush x:Key="Pink" Color="#A335EE"/>
    <SolidColorBrush x:Key="Gold" Color="#FFD100"/>
    <SolidColorBrush x:Key="GoldSoft" Color="#1FFFD100"/>
    <SolidColorBrush x:Key="Ok" Color="#4ADE6B"/>
    <SolidColorBrush x:Key="OkSoft" Color="#1F4ADE6B"/>
    <SolidColorBrush x:Key="Bad" Color="#FF5A4E"/>
    <SolidColorBrush x:Key="BadSoft" Color="#1FFF5A4E"/>
    <!-- Dégradé des boutons : couleur de faction vers or -->
    <LinearGradientBrush x:Key="Grad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#8C1616" Offset="0"/>
      <GradientStop Color="#C8961E" Offset="1"/>
    </LinearGradientBrush>
    <!-- Or des titres et des cadres -->
    <LinearGradientBrush x:Key="GoldGrad" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFE9A3" Offset="0"/>
      <GradientStop Color="#E0A82E" Offset="0.55"/>
      <GradientStop Color="#9C6B12" Offset="1"/>
    </LinearGradientBrush>

    <FontFamily x:Key="Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Cinzel : police libre (SIL OFL 1.1), style gravé dans la pierre. -->
    <FontFamily x:Key="Display">pack://application:,,,/Fonts/#Cinzel</FontFamily>
    <FontFamily x:Key="Deco">pack://application:,,,/Fonts/#Cinzel Decorative</FontFamily>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <local:BoolToVis x:Key="BoolToVis"/>
    <local:GraviteBrush x:Key="GraviteBrush"/>
    <local:CountBrush x:Key="CountBrush"/>

    <!-- Textes -->
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="Foreground" Value="{StaticResource GoldGrad}"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Carte -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line2}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <!-- Case à cocher GhostWalk -->
    <Style x:Key="GwCheck" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="22" Height="22" CornerRadius="3" Background="{DynamicResource Panel2}"
                      BorderBrush="{StaticResource Line2}" BorderThickness="1.5" VerticalAlignment="Center">
                <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Brand2}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{DynamicResource Grad}"/>
                <Setter TargetName="box" Property="BorderThickness" Value="0"/>
                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value=".35"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Boutons -->
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="20,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="4" Background="{DynamicResource Grad}" BorderBrush="{StaticResource GoldGrad}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value=".88"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value=".75"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value=".35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="4" Background="{DynamicResource Panel2}" BorderBrush="{StaticResource Line2}"
                    BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Brand2}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value=".35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#18FFFFFF"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ChromeClose" TargetType="Button" BasedOn="{StaticResource Chrome}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#E81123"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Navigation de gauche -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" CornerRadius="4" Padding="14,11" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ic" Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="16"
                           VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource Ink3}"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#0DFFFFFF"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource BrandSoft}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Line2}"/>
                <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                <Setter TargetName="ic" Property="Foreground" Value="{StaticResource Gold}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Pastilles (période du journal) -->
    <Style x:Key="Pill" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" CornerRadius="999" Padding="14,7" Background="{DynamicResource Panel2}"
                    BorderBrush="{StaticResource Line2}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Grad}"/>
                <Setter TargetName="b" Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Bouton « Détail » -->
    <Style x:Key="Toggle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource Brand2}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="Transparent" Padding="0,2">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Barre de défilement fine -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="t" CornerRadius="4" Background="#40D4AF37" Margin="2,2"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="#44FFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{DynamicResource Panel2}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line2}"/>
    </Style>
  </Application.Resources>
</Application>
