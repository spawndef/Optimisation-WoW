<Window x:Class="OptimisationWoW.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Optimisation de Windows pour World of Warcraft" Icon="icone.ico"
        Width="1200" Height="820" MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg}" FontFamily="{StaticResource Font}" Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Une ligne avec case à cocher (réglage, programme au démarrage ou appli) -->
    <DataTemplate x:Key="ItemRow">
      <Border x:Name="row" CornerRadius="12" Padding="14,12" Margin="0,0,0,6" Background="Transparent"
              BorderThickness="1" BorderBrush="Transparent">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <CheckBox Style="{StaticResource GwCheck}" IsChecked="{Binding Desired, Mode=TwoWay}" IsEnabled="{Binding CanChange}"
                    VerticalAlignment="Top" Margin="0,1,14,0" ToolTip="Coché = on désactive / on retire"/>
          <StackPanel Grid.Column="1">
            <WrapPanel>
              <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                         TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Border x:Name="reco" CornerRadius="999" Padding="8,1,8,2" VerticalAlignment="Center" Background="#0DFFFFFF">
                <TextBlock x:Name="recoText" Text="{Binding RecoText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Ink3}"/>
              </Border>
            </WrapPanel>
            <TextBlock Text="{Binding Desc}" Style="{StaticResource Sub}" Margin="0,3,0,0"/>
            <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{StaticResource Gold}" TextWrapping="Wrap" Margin="0,5,0,0"
                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
          </StackPanel>
          <Button Grid.Column="2" Style="{StaticResource Ghost}" Content="Ouvrir Paramètres" Padding="10,5" FontSize="12"
                  Margin="12,0,0,0" VerticalAlignment="Center" Click="OpenSettings_Click"
                  Visibility="{Binding HasSettings, Converter={StaticResource BoolToVis}}"/>
          <Border Grid.Column="3" x:Name="pill" CornerRadius="999" Padding="10,4" Margin="12,0,0,0" MinWidth="90"
                  VerticalAlignment="Center" Background="#0DFFFFFF">
            <TextBlock x:Name="pillText" Text="{Binding Status}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource Ink3}" HorizontalAlignment="Center"/>
          </Border>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="row" Property="IsMouseOver" Value="True">
          <Setter TargetName="row" Property="Background" Value="#08FFFFFF"/>
        </Trigger>
        <DataTrigger Binding="{Binding StatusIsGood}" Value="True">
          <Setter TargetName="pill" Property="Background" Value="{StaticResource OkSoft}"/>
          <Setter TargetName="pillText" Property="Foreground" Value="{StaticResource Ok}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Reco}" Value="Recommande">
          <Setter TargetName="reco" Property="Background" Value="{DynamicResource BrandSoft}"/>
          <Setter TargetName="recoText" Property="Foreground" Value="{DynamicResource Brand2}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Reco}" Value="AGarder">
          <Setter TargetName="reco" Property="Background" Value="{StaticResource GoldSoft}"/>
          <Setter TargetName="recoText" Property="Foreground" Value="{StaticResource Gold}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Changed}" Value="True">
          <Setter TargetName="row" Property="Background" Value="{DynamicResource BrandSoft}"/>
          <Setter TargetName="row" Property="BorderBrush" Value="#557C5CFF"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Une ligne du journal -->
    <DataTemplate x:Key="EventRow">
      <Border Padding="4,13" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Ellipse Width="10" Height="10" VerticalAlignment="Top" Margin="2,6,14,0"
                   Fill="{Binding Gravite, Converter={StaticResource GraviteBrush}}"/>
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Explain}" Style="{StaticResource Sub}" Margin="0,3,0,0"/>
            <WrapPanel Margin="0,5,0,0">
              <TextBlock Text="{Binding GraviteText}" FontSize="11" FontWeight="SemiBold"
                         Foreground="{Binding Gravite, Converter={StaticResource GraviteBrush}}"/>
              <TextBlock Text="  ·  " FontSize="11" Foreground="{StaticResource Ink3}"/>
              <TextBlock Text="{Binding Source}" FontSize="11" Foreground="{StaticResource Ink3}"/>
              <TextBlock Text="  ·  " FontSize="11" Foreground="{StaticResource Ink3}"/>
              <ToggleButton x:Name="det" Style="{StaticResource Toggle}" Content="Voir le message"/>
            </WrapPanel>
            <Border Background="{DynamicResource Bg2}" CornerRadius="10" Padding="12,10" Margin="0,8,0,0"
                    Visibility="{Binding IsChecked, ElementName=det, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{Binding Sample}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                         Foreground="{StaticResource Ink2}" TextWrapping="Wrap"/>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="18,0,4,0">
            <TextBlock Text="{Binding CountText}" FontFamily="{StaticResource Display}" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource Ink}" HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding LastText}" FontSize="11" Foreground="{StaticResource Ink3}" HorizontalAlignment="Right"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- Une ligne de la page « Applis ouvertes » -->
    <DataTemplate x:Key="AppRow">
      <Border x:Name="row" CornerRadius="12" Padding="16,12" Margin="0,0,0,6" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource Panel2}" Margin="0,0,14,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="16"
                       Foreground="{DynamicResource Brand2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <WrapPanel>
              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <Border x:Name="badge" CornerRadius="999" Padding="8,1,8,2" Background="#0DFFFFFF" VerticalAlignment="Center">
                <TextBlock x:Name="badgeText" Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Ink3}"/>
              </Border>
            </WrapPanel>
            <TextBlock Text="{Binding Details}" Style="{StaticResource Sub}" FontSize="12" Margin="0,3,0,0"/>
            <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{StaticResource Ink3}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="16,0,16,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding RamText}" FontFamily="{StaticResource Display}" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource Ink}" HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding ReservedText}" FontSize="11" Foreground="{StaticResource Ink3}" HorizontalAlignment="Right"/>
          </StackPanel>
          <Button Grid.Column="3" x:Name="closeBtn" Style="{StaticResource Ghost}" Content="Fermer" Click="CloseApp_Click"
                  VerticalAlignment="Center" MinWidth="86" Visibility="{Binding CanClose, Converter={StaticResource BoolToVis}}"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="row" Property="IsMouseOver" Value="True">
          <Setter TargetName="row" Property="Background" Value="#08FFFFFF"/>
        </Trigger>
        <DataTrigger Binding="{Binding BadgeKind}" Value="suspect">
          <Setter TargetName="row" Property="Background" Value="{StaticResource GoldSoft}"/>
          <Setter TargetName="row" Property="BorderBrush" Value="#55FFC94D"/>
          <Setter TargetName="badge" Property="Background" Value="{StaticResource GoldSoft}"/>
          <Setter TargetName="badgeText" Property="Foreground" Value="{StaticResource Gold}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding BadgeKind}" Value="keep">
          <Setter TargetName="badge" Property="Background" Value="{StaticResource OkSoft}"/>
          <Setter TargetName="badgeText" Property="Foreground" Value="{StaticResource Ok}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Petite carte chiffre du journal -->
    <Style x:Key="Stat" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="18,14"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
    </Style>
    <Style x:Key="StatNum" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="30"/>
    </Style>
    <Style x:Key="StatLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ═════════ Barre de titre ═════════ -->
    <Border Background="{DynamicResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
            <RadioButton x:Name="FactionHorde" Style="{StaticResource Pill}" GroupName="faction" Content="⚔  Horde" Checked="Faction_Checked"/>
            <RadioButton x:Name="FactionAlliance" Style="{StaticResource Pill}" GroupName="faction" Content="🛡  Alliance" Checked="Faction_Checked"/>
          </StackPanel>
          <Button Style="{StaticResource Chrome}" Content="&#xE921;" Click="Min_Click" ToolTip="Réduire"/>
          <Button x:Name="MaxBtn" Style="{StaticResource Chrome}" Content="&#xE922;" Click="Max_Click" ToolTip="Agrandir"/>
          <Button Style="{StaticResource ChromeClose}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Fermer"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
          <!-- Emblème : losange de faction cerclé d'or -->
          <Grid Width="34" Height="34">
            <Border Width="24" Height="24" Background="{DynamicResource Grad}" BorderBrush="{StaticResource GoldGrad}" BorderThickness="1.5"
                    RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform><RotateTransform Angle="45"/></Border.RenderTransform>
            </Border>
            <TextBlock Text="⚔" FontSize="14" Foreground="#FFF5E0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
          </Grid>
          <TextBlock Text="Optimisation de Windows" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="17"
                     Foreground="{StaticResource GoldGrad}" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <TextBlock Text="pour World of Warcraft" FontFamily="{StaticResource Display}" FontSize="13" Foreground="{StaticResource Ink2}"
                     VerticalAlignment="Center" Margin="10,2,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="236"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Lueur de la faction, en haut de la page -->
      <Border Grid.Column="1" Background="{DynamicResource Glow}" IsHitTestVisible="False">
        <Border.OpacityMask>
          <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.75" RadiusY="0.6">
            <GradientStop Color="#FF000000" Offset="0"/>
            <GradientStop Color="#00000000" Offset="1"/>
          </RadialGradientBrush>
        </Border.OpacityMask>
      </Border>

      <!-- ═════════ Menu de gauche ═════════ -->
      <Border Background="{DynamicResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <DockPanel Margin="14,18,14,16">
          <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14,12">
            <StackPanel>
              <TextBlock Text="TON PC" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Ink3}"/>
              <TextBlock x:Name="SysInfo" Text="Lecture…" FontSize="12" Foreground="{StaticResource Ink2}" TextWrapping="Wrap" Margin="0,6,0,10"/>
              <Button Style="{StaticResource Ghost}" Click="OpenBackups_Click" Padding="10,6" FontSize="12"
                      ToolTip="Chaque réglage est sauvegardé avant d'être changé.">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" Margin="0,1,8,0"/>
                  <TextBlock Text="Sauvegardes"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
          <StackPanel>
            <RadioButton x:Name="NavWow" Style="{StaticResource Nav}" Tag="&#xE7FC;" Content="World of Warcraft" IsChecked="True" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavOpti" Style="{StaticResource Nav}" Tag="&#xE945;" Content="Windows" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavJournal" Style="{StaticResource Nav}" Tag="&#xE9D9;" Content="Journal Windows" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavApps" Style="{StaticResource Nav}" Tag="&#xE7B8;" Content="Applis ouvertes" Checked="Nav_Checked"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ═════════ Page World of Warcraft ═════════ -->
      <Grid x:Name="WowPage" Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="32,26,28,24" MaxWidth="1000">
            <DockPanel Margin="0,0,0,16">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource Ghost}" Click="WowPick_Click" Margin="0,0,8,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" Margin="0,1,8,0"/>
                    <TextBlock Text="Choisir le dossier de WoW"/>
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource Ghost}" Click="WowReload_Click" ToolTip="Relire">
                  <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}"/>
                </Button>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="World of Warcraft" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Sub}" FontSize="14" Margin="0,6,0,0"
                           Text="Les réglages qui comptent pour WoW. Ceux de Windows sont dans l'onglet « Windows »."/>
              </StackPanel>
            </DockPanel>

            <WrapPanel x:Name="FlavorPills" Margin="0,0,0,14"/>

            <!-- Introuvable -->
            <Border x:Name="WowNone" Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,14" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="WoW introuvable" Style="{StaticResource H2}" Foreground="{StaticResource Gold}"/>
                <TextBlock Style="{StaticResource Sub}" FontSize="14" Margin="0,6,0,0"
                           Text="Clique « Choisir le dossier de WoW » et montre le dossier « World of Warcraft » (celui qui contient _retail_, _classic_…)."/>
              </StackPanel>
            </Border>

            <!-- L'installation -->
            <Border x:Name="WowCard" Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,14" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock x:Name="WowTitle" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="21" Foreground="{StaticResource GoldGrad}"/>
                  <TextBlock x:Name="WowPath" FontSize="12" Foreground="{StaticResource Ink3}" Margin="0,3,0,0"/>
                  <WrapPanel Margin="0,12,0,0">
                    <Border x:Name="WowStatePill" CornerRadius="999" Padding="10,3" Background="{StaticResource OkSoft}" Margin="0,0,12,0">
                      <TextBlock x:Name="WowState" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ok}"/>
                    </Border>
                    <TextBlock x:Name="WowInfo" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                  </WrapPanel>
                </StackPanel>
                <Button Grid.Column="1" x:Name="CacheBtn" Style="{StaticResource Ghost}" Click="WowCache_Click" VerticalAlignment="Center"
                        ToolTip="WoW refait son cache tout seul. Ça corrige souvent les bugs d'affichage et les chargements bizarres.">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" Margin="0,1,8,0"/>
                    <TextBlock x:Name="CacheBtnWowText" Text="Vider le cache de WoW"/>
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <!-- Réglages du jeu -->
            <Border x:Name="WowTweaksCard" Style="{StaticResource Card}" Padding="18,18,18,10" Visibility="Collapsed">
              <StackPanel>
                <DockPanel Margin="6,0,6,12">
                  <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="WowRecommend_Click" VerticalAlignment="Top" Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE734;" FontFamily="{StaticResource Icons}" Margin="0,2,8,0"/>
                      <TextBlock Text="Cocher les recommandations"/>
                    </StackPanel>
                  </Button>
                  <StackPanel>
                    <TextBlock Text="Réglages du jeu" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,3,0,0"
                               Text="Écrits dans le fichier Config.wtf de WoW. WoW doit être fermé pour les changer : il réécrit ses réglages en quittant. Une copie du fichier d'origine est gardée à côté."/>
                  </StackPanel>
                </DockPanel>
                <ItemsControl x:Name="WowList" ItemTemplate="{StaticResource ItemRow}"/>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Sub}" FontSize="11" Foreground="{StaticResource Ink3}" Margin="4,18,0,0"
                       Text="Application gratuite et non officielle, sans lien avec Blizzard Entertainment. World of Warcraft est une marque de Blizzard Entertainment, Inc."/>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="32,14,28,14">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="WowCancelBtn" Style="{StaticResource Ghost}" Content="Annuler" Margin="0,0,10,0" Click="WowCancel_Click"/>
              <Button x:Name="WowApplyBtn" Style="{StaticResource Primary}" Content="Appliquer" Click="WowApply_Click"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="WowPendingText" Text="Aucun changement en attente." FontWeight="SemiBold" FontSize="14"/>
              <TextBlock x:Name="WowResultText" FontSize="12" Foreground="{StaticResource Ink2}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,3,0,0"/>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>

      <!-- ═════════ Page Optimisation ═════════ -->
      <Grid x:Name="OptiPage" Grid.Column="1" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="32,26,28,24" MaxWidth="1000">
            <DockPanel Margin="0,0,0,20">
              <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="Reload_Click" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" Margin="0,1,8,0"/>
                  <TextBlock Text="Relire l'état"/>
                </StackPanel>
              </Button>
              <StackPanel>
                <TextBlock Text="Optimisation" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Sub}" FontSize="14" Margin="0,6,0,0">
                  <Run Text="Coché" Foreground="{DynamicResource Brand2}" FontWeight="SemiBold"/><Run Text=" = on fait le ménage (désactivé, bloqué ou retiré). Rien ne change tant que tu n'as pas cliqué « Appliquer »."/>
                </TextBlock>
              </StackPanel>
            </DockPanel>

            <!-- Pour ceux qui ne savent pas à quoi servent les options -->
            <Border Style="{StaticResource Card}" BorderBrush="#557C5CFF" Background="{DynamicResource BrandSoft}" Padding="24,20" Margin="0,0,0,16">
              <StackPanel>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="Recommend_Click" VerticalAlignment="Center" Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE734;" FontFamily="{StaticResource Icons}" Margin="0,2,8,0"/>
                      <TextBlock Text="Cocher les recommandations"/>
                    </StackPanel>
                  </Button>
                  <StackPanel>
                    <TextBlock Text="Tu ne sais pas quoi choisir ?" Style="{StaticResource H2}" FontSize="19"/>
                    <TextBlock Style="{StaticResource Sub}" FontSize="14" Margin="0,4,0,0">
                      <Run Text="Clique sur le bouton : on coche seulement ce qui est"/><Run Text=" sans risque " FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><Run Text="pour ton PC et tes jeux. Vérifie la liste, puis clique « Appliquer » en bas."/>
                    </TextBlock>
                  </StackPanel>
                </DockPanel>
                <WrapPanel Margin="0,16,0,0">
                  <TextBlock Text="Afficher :" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <RadioButton x:Name="ViewSimple" Style="{StaticResource Pill}" GroupName="vue" Content="★ Recommandé seulement" IsChecked="True" Checked="View_Checked"/>
                  <RadioButton x:Name="ViewAll" Style="{StaticResource Pill}" GroupName="vue" Content="Tout voir" Checked="View_Checked"/>
                </WrapPanel>
                <WrapPanel Margin="0,14,0,0">
                  <Border CornerRadius="999" Padding="8,1,8,2" Background="{DynamicResource BrandSoft}" Margin="0,0,6,4">
                    <TextBlock Text="★ Recommandé" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brand2}"/>
                  </Border>
                  <TextBlock Text="sans risque, à cocher     " FontSize="12" Foreground="{StaticResource Ink2}" Margin="0,0,0,4"/>
                  <Border CornerRadius="999" Padding="8,1,8,2" Background="#0DFFFFFF" Margin="0,0,6,4">
                    <TextBlock Text="Au choix" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Ink3}"/>
                  </Border>
                  <TextBlock Text="dépend si tu t'en sers     " FontSize="12" Foreground="{StaticResource Ink2}" Margin="0,0,0,4"/>
                  <Border CornerRadius="999" Padding="8,1,8,2" Background="{StaticResource GoldSoft}" Margin="0,0,6,4">
                    <TextBlock Text="À garder" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Gold}"/>
                  </Border>
                  <TextBlock Text="utile au PC ou aux jeux, n'y touche pas" FontSize="12" Foreground="{StaticResource Ink2}" Margin="0,0,0,4"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <TextBlock x:Name="OptiLoading" Text="Lecture des réglages…" Style="{StaticResource Sub}" Margin="0,0,0,16"/>

            <ItemsControl x:Name="SectionsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Padding="18,18,18,10" Margin="0,0,0,16">
                    <StackPanel>
                      <DockPanel Margin="6,0,6,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Tout cocher" Padding="10,5" FontSize="12"
                                VerticalAlignment="Top" Tag="{Binding}" Click="CheckSection_Click"
                                Visibility="{Binding AllowAll, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" Style="{StaticResource H2}"/>
                          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Sub}" Margin="0,3,0,0"/>
                        </StackPanel>
                      </DockPanel>
                      <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ItemRow}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Nettoyage -->
            <Border Style="{StaticResource Card}" Padding="24,18">
              <DockPanel>
                <Button x:Name="CleanBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="Clean_Click" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" Margin="0,1,8,0"/>
                    <TextBlock x:Name="CleanBtnText" Text="Vider"/>
                  </StackPanel>
                </Button>
                <StackPanel>
                  <TextBlock Text="Nettoyage" Style="{StaticResource H2}"/>
                  <TextBlock x:Name="TempText" Text="Fichiers temporaires : calcul…" Style="{StaticResource Sub}" Margin="0,3,0,0"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Barre du bas : changements en attente -->
        <Border Grid.Row="1" Background="{DynamicResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="32,14,28,14">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="CancelBtn" Style="{StaticResource Ghost}" Content="Annuler" Margin="0,0,10,0" Click="Cancel_Click"/>
              <Button x:Name="ApplyBtn" Style="{StaticResource Primary}" Content="Appliquer" Click="Apply_Click"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="PendingText" Text="Aucun changement en attente." FontWeight="SemiBold" FontSize="14"/>
              <TextBlock x:Name="ResultText" FontSize="12" Foreground="{StaticResource Ink2}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,3,0,0"/>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>

      <!-- ═════════ Page Journal ═════════ -->
      <ScrollViewer x:Name="JournalPage" Grid.Column="1" Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,28,32" MaxWidth="1000">
          <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
              <RadioButton x:Name="P24" Style="{StaticResource Pill}" Content="24 h" GroupName="periode" Checked="Period_Checked"/>
              <RadioButton x:Name="P7" Style="{StaticResource Pill}" Content="7 jours" GroupName="periode" IsChecked="True" Checked="Period_Checked"/>
              <RadioButton x:Name="P30" Style="{StaticResource Pill}" Content="30 jours" GroupName="periode" Checked="Period_Checked"/>
              <Button Style="{StaticResource Ghost}" Margin="6,0,0,0" Click="JournalReload_Click" ToolTip="Relire le journal">
                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}"/>
              </Button>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Journal Windows" Style="{StaticResource H1}"/>
              <TextBlock Text="Les erreurs et avertissements de Windows, regroupés et expliqués en français." Style="{StaticResource Sub}" FontSize="14" Margin="0,6,0,0"/>
            </StackPanel>
          </DockPanel>

          <!-- Verdict + résumé abrégé -->
          <Border Style="{StaticResource Card}" Margin="0,0,0,14" ClipToBounds="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="VerdictBar" Background="{StaticResource Ink3}" CornerRadius="16,0,0,16"/>
              <StackPanel Grid.Column="1" Margin="20,18,22,18">
                <TextBlock Text="RÉSUMÉ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Ink3}"/>
                <TextBlock x:Name="VerdictText" Text="Lecture du journal…" FontFamily="{StaticResource Display}" FontWeight="Bold"
                           FontSize="22" Margin="0,4,0,6"/>
                <TextBlock x:Name="SummaryText" Style="{StaticResource Sub}" FontSize="14" LineHeight="21"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Les chiffres importants -->
          <UniformGrid x:Name="StatsGrid" Columns="3" Margin="0,0,-12,2">
            <Border Style="{StaticResource Stat}">
              <StackPanel>
                <TextBlock Text="{Binding Restarts}" Style="{StaticResource StatNum}" Foreground="{Binding Restarts, Converter={StaticResource CountBrush}}"/>
                <TextBlock Text="Redémarrages imprévus" Style="{StaticResource StatLabel}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Stat}">
              <StackPanel>
                <TextBlock Text="{Binding Bsod}" Style="{StaticResource StatNum}" Foreground="{Binding Bsod, Converter={StaticResource CountBrush}, ConverterParameter=bad}"/>
                <TextBlock Text="Écrans bleus" Style="{StaticResource StatLabel}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Stat}">
              <StackPanel>
                <TextBlock Text="{Binding Gpu}" Style="{StaticResource StatNum}" Foreground="{Binding Gpu, Converter={StaticResource CountBrush}}"/>
                <TextBlock Text="Plantages du pilote graphique" Style="{StaticResource StatLabel}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Stat}">
              <StackPanel>
                <TextBlock Text="{Binding Hardware}" Style="{StaticResource StatNum}" Foreground="{Binding Hardware, Converter={StaticResource CountBrush}}"/>
                <TextBlock Text="Erreurs matérielles" Style="{StaticResource StatLabel}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Stat}">
              <StackPanel>
                <TextBlock Text="{Binding Disk}" Style="{StaticResource StatNum}" Foreground="{Binding Disk, Converter={StaticResource CountBrush}, ConverterParameter=bad}"/>
                <TextBlock Text="Problèmes de disque" Style="{StaticResource StatLabel}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Stat}">
              <StackPanel>
                <TextBlock Text="{Binding AppCrashes}" Style="{StaticResource StatNum}" Foreground="{Binding AppCrashes, Converter={StaticResource CountBrush}}"/>
                <TextBlock Text="Applis plantées" Style="{StaticResource StatLabel}"/>
              </StackPanel>
            </Border>
          </UniformGrid>

          <!-- Détail -->
          <Border Style="{StaticResource Card}" Padding="22,18,22,8">
            <StackPanel>
              <DockPanel Margin="0,0,0,6">
                <CheckBox x:Name="ShowNoise" DockPanel.Dock="Right" Style="{StaticResource GwCheck}" Checked="ShowNoise_Changed" Unchecked="ShowNoise_Changed">
                  <TextBlock Text="Montrer les messages sans gravité" FontSize="13" Foreground="{StaticResource Ink2}"/>
                </CheckBox>
                <StackPanel>
                  <TextBlock Text="Détail" Style="{StaticResource H2}"/>
                  <TextBlock x:Name="DetailSub" Style="{StaticResource Sub}" Margin="0,3,0,0"/>
                </StackPanel>
              </DockPanel>
              <ItemsControl x:Name="EventsList" ItemTemplate="{StaticResource EventRow}"/>
              <TextBlock x:Name="EventsEmpty" Text="Aucun message pour cette période. 🎉" Style="{StaticResource Sub}" Margin="0,10,0,14" Visibility="Collapsed"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ═════════ Page Applis ouvertes ═════════ -->
      <ScrollViewer x:Name="AppsPage" Grid.Column="1" Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,28,32" MaxWidth="1000">
          <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
              <Button Style="{StaticResource Ghost}" Click="OpenTaskManager_Click" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" Margin="0,1,8,0"/>
                  <TextBlock Text="Gestionnaire des tâches"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource Ghost}" Click="AppsReload_Click" ToolTip="Actualiser">
                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}"/>
              </Button>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Applis ouvertes" Style="{StaticResource H1}"/>
              <TextBlock Style="{StaticResource Sub}" FontSize="14" Margin="0,6,0,0"
                         Text="Les programmes hors Microsoft qui prennent le plus de mémoire. Un gros programme « sans fenêtre » a souvent été mal fermé (un jeu, un launcher) : ferme-le avant de jouer."/>
            </StackPanel>
          </DockPanel>

          <!-- Mémoire du PC -->
          <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,14">
            <StackPanel>
              <DockPanel>
                <TextBlock x:Name="MemPercent" DockPanel.Dock="Right" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="18"/>
                <StackPanel>
                  <TextBlock Text="MÉMOIRE DU PC (RAM)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Ink3}"/>
                  <TextBlock x:Name="MemText" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="20" Margin="0,4,0,0"/>
                </StackPanel>
              </DockPanel>
              <Grid Height="10" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition x:Name="MemUsedCol" Width="0*"/>
                  <ColumnDefinition x:Name="MemFreeCol" Width="1*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" CornerRadius="5" Background="{DynamicResource Panel2}"/>
                <Border x:Name="MemBar" CornerRadius="5" Background="{DynamicResource Grad}"/>
              </Grid>
              <TextBlock x:Name="MemTip" Style="{StaticResource Sub}" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>

          <!-- Un autre compte Windows resté ouvert -->
          <Border x:Name="OtherSessionsCard" Style="{StaticResource Card}" Background="{StaticResource GoldSoft}" BorderBrush="#55FFC94D"
                  Padding="22,18" Margin="0,0,0,14" Visibility="Collapsed">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Gestionnaire des tâches" Click="OpenTaskManager_Click"
                      VerticalAlignment="Center" Margin="16,0,0,0"/>
              <StackPanel>
                <TextBlock x:Name="OtherSessionsTitle" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="17" Foreground="{StaticResource Gold}"/>
                <TextBlock x:Name="OtherSessionsText" Style="{StaticResource Sub}" FontSize="13" Margin="0,6,0,0" LineHeight="19"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <TextBlock x:Name="AppsResult" FontSize="13" TextWrapping="Wrap" Margin="4,0,0,12" Visibility="Collapsed"/>

          <Border Style="{StaticResource Card}" Padding="16,16,16,10">
            <StackPanel>
              <TextBlock x:Name="AppsSub" Style="{StaticResource Sub}" Margin="8,0,0,10" Text="Lecture…"/>
              <ItemsControl x:Name="AppsList" ItemTemplate="{StaticResource AppRow}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
